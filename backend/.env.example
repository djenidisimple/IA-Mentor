# IA Mentor — variables d'environnement (exemple vide)
# ⚠️ NE JAMAIS committer les valeurs réelles ; elles doivent être fournies
# par l'utilisateur via le système de secrets du déploiement ou un .env local non suivi.

# Connexion base de données
spring.datasource.url=jdbc:postgresql://localhost:5432/ai_mentor_db
spring.datasource.username=postgres
spring.datasource.password=change-me

# Sécurité JWT
application.security.jwt.secret-key=replace-with-a-long-random-secret
# Durée de l'access token en MILLISECONDES (900000 = 15 min)
application.security.jwt.expiration=900000
# Durée de la session de refresh en JOURS (90 par défaut)
application.security.jwt.refresh-expiration=90
# Fenêtre de grâce tolérée pour l'ancien refresh token, en SECONDES
application.security.jwt.refresh-grace-seconds=30
# Nombre maximum d'appareils connectés simultanément
application.security.jwt.max-sessions=10

# OAuth GitHub
spring.security.oauth2.client.registration.github.client-id=your-github-client-id
spring.security.oauth2.client.registration.github.client-secret=your-github-client-secret

# Service IA — OpenRouter
# La clé se obtient sur https://openrouter.ai/keys
OPENROUTER_API_KEY=votre-cle-api-ici
# Modèles gratuits (suffixe :free), séparés par des virgules ; le premier est utilisé
ai.models=cohere/north-mini-code:free,google/gemma-4-31b-it:free
ai.api.url=https://openrouter.ai/api/v1/chat/completions
ai.max.tokens=4096

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080

# Cookie du refresh token
# En production (HTTPS) : passer secure à true
app.cookie.refresh-token.secure=false
app.cookie.refresh-token.same-site=Strict
# app.cookie.refresh-token.domain=example.com

# Origines autorisées par le CORS (liste séparée par des virgules)
app.cors.allowed-origins=http://localhost:3000

# Redirection après le flux OAuth2 GitHub
app.oauth2.redirect-uri=http://localhost:3000/oauth2/callback
app.oauth2.code-ttl-seconds=60

# Limitation de débit sur les routes d'authentification
app.rate-limit.auth.max-requests=20
app.rate-limit.auth.window-seconds=60