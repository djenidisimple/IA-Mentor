# IA Mentor — variables d'environnement (exemple vide)
# ⚠️ NE JAMAIS committer les valeurs réelles ; elles doivent être fournies
# par l'utilisateur via le système de secrets du déploiement ou un .env local non suivi.

# Connexion base de données
spring.datasource.url=jdbc:postgresql://localhost:5432/ai_mentor_db
spring.datasource.username=postgres
spring.datasource.password=change-me

# Sécurité JWT
application.security.jwt.secret-key=replace-with-a-long-random-secret
application.security.jwt.expiration=900000
application.security.jwt.refresh-expiration=7776000000

# OAuth GitHub
spring.security.oauth2.client.registration.github.client-id=your-github-client-id
spring.security.oauth2.client.registration.github.client-secret=your-github-client-secret

# Service IA — OpenRouter
# La clé se obtient sur https://openrouter.ai/keys
OPENROUTER_API_KEY=votre-cle-api-ici
# Modèles gratuits (suffixe :free), séparés par des virgules ; le premier est utilisé
ai.models=cohere/north-mini-code:free,google/gemma-4-31b-it:free
ai.api.url=https://openrouter.ai/api/v1/chat/completions
ai.max.tokens=4096

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080